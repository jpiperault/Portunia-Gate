# Copiez ce fichier en .env et remplacez les valeurs.

# Mot de passe de la base (long et aléatoire) : openssl rand -base64 32
HEIMDIA_DB_PASSWORD=a-remplacer

# Port SSH exposé par la Gate.
HEIMDIA_SSH_PORT=2222

# Port de l'API HTTPS utilisée par Portunia.
HEIMDIA_API_PORT=8443

# Fuseau horaire des règles d'accès (plages horaires).
TZ=Europe/Paris
