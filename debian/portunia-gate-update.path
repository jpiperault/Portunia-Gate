# Mise à jour de la Gate demandée depuis Portunia ou « portunia-gate update apply » :
# la Gate (sans droits) dépose la demande, portunia-gate-update.service (root) l'exécute.
[Unit]
Description=Portunia Gate, demandes de mise à jour

[Path]
PathExists=/var/lib/portunia-gate/mise-a-jour/demande.json
# Navigateur du portail (0.55) : activer, compléter ou arrêter, demandé depuis Portunia.
PathExists=/var/lib/portunia-gate/mise-a-jour/navigateur.json
Unit=portunia-gate-update.service

[Install]
WantedBy=multi-user.target
