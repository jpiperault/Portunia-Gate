#!/bin/sh
set -e

if [ -d /run/systemd/system ]; then systemctl daemon-reload || true; fi

if [ "$1" = purge ]; then
  rm -rf /etc/portunia-gate
  # Les données (clé du coffre, enregistrements) et la base sont gardées : les effacer doit être
  # un geste délibéré (rm -rf /var/lib/portunia-gate ; sudo -u postgres dropdb portunia_gate).
  echo "Portunia Gate : /var/lib/portunia-gate et la base PostgreSQL « portunia_gate » sont conservées." >&2
fi

exit 0
